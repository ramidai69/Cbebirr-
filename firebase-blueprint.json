{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized owner/administrator allowed to inspect all devices, transactions, locks, and timed notifications.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email address",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Role identifier strictly locked to admin"
        },
        "ownerId": {
          "type": "string",
          "description": "Creator UID matching request.auth.uid",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "role", "ownerId", "createdAt", "updatedAt"]
    },
    "DeviceClient": {
      "title": "DeviceClient",
      "description": "Registered CBEBirr Plus device installation with online heartbeat, profile details, and per-device lock flag.",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "description": "Unique persistent device identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "description": "Human-readable phone/browser label",
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "enum": ["android-apk", "web-pwa", "web"],
          "description": "Runtime client platform"
        },
        "appVersion": {
          "type": "string",
          "description": "Installed app/bundle version string",
          "maxLength": 40
        },
        "userName": {
          "type": "string",
          "description": "Display profile name configured inside the app",
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number entered on login screen",
          "maxLength": 32
        },
        "userAccount": {
          "type": "string",
          "description": "Account number/phone configured in app",
          "maxLength": 64
        },
        "balance": {
          "type": "number",
          "description": "Current ETB balance on this device"
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether the owner has remotely locked this specific device"
        },
        "lockReason": {
          "type": "string",
          "description": "Optional lock banner message shown on this device",
          "maxLength": 240
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "New device registration approval status managed by owner"
        },
        "lastSeenAtMs": {
          "type": "number",
          "description": "Unix epoch ms of the latest heartbeat from this device"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this device record",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "deviceId",
        "deviceName",
        "platform",
        "appVersion",
        "userName",
        "phoneNumber",
        "userAccount",
        "balance",
        "isLocked",
        "lastSeenAtMs",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeviceTransaction": {
      "title": "DeviceTransaction",
      "description": "Real-time transfer, bill payment, or deposit logged by a specific device.",
      "type": "object",
      "properties": {
        "txId": {
          "type": "string",
          "description": "Unique transaction record ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Originating device identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "description": "Originating device human-readable label",
          "maxLength": 120
        },
        "senderName": {
          "type": "string",
          "description": "App profile name at time of transaction",
          "maxLength": 120
        },
        "senderPhone": {
          "type": "string",
          "description": "App phone number at time of transaction",
          "maxLength": 32
        },
        "senderAccount": {
          "type": "string",
          "description": "App account number at time of transaction",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Transaction category title",
          "maxLength": 80
        },
        "txType": {
          "type": "string",
          "enum": ["debit", "credit"],
          "description": "Debit or credit direction"
        },
        "amount": {
          "type": "number",
          "description": "Transfer amount in ETB"
        },
        "totalDeducted": {
          "type": "number",
          "description": "Total deducted including fee and VAT"
        },
        "balanceAfter": {
          "type": "number",
          "description": "Resulting balance after transaction"
        },
        "recipientName": {
          "type": "string",
          "description": "Recipient full name",
          "maxLength": 120
        },
        "recipientAccount": {
          "type": "string",
          "description": "Recipient phone or bank account",
          "maxLength": 64
        },
        "destBank": {
          "type": "string",
          "description": "Destination bank or wallet name",
          "maxLength": 80
        },
        "transferLabel": {
          "type": "string",
          "description": "Dynamic transfer label (CBEBirr, CBE, or bank/wallet name)",
          "maxLength": 80
        },
        "ref": {
          "type": "string",
          "description": "CBE FT reference or 8-char Txn ID",
          "maxLength": 64
        },
        "reason": {
          "type": "string",
          "description": "Transaction remark or reason",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["Completed", "Pending", "Failed"],
          "description": "Transaction completion status"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this transaction",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAtMs": {
          "type": "number",
          "description": "Unix epoch ms when transaction occurred"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "txId",
        "deviceId",
        "deviceName",
        "senderName",
        "senderPhone",
        "senderAccount",
        "title",
        "txType",
        "amount",
        "totalDeducted",
        "balanceAfter",
        "recipientName",
        "recipientAccount",
        "transferLabel",
        "ref",
        "reason",
        "status",
        "ownerId",
        "createdAtMs",
        "createdAt"
      ]
    },
    "OwnerNotification": {
      "title": "OwnerNotification",
      "description": "Timed notification-style alert dispatched by owner to one device or all devices.",
      "type": "object",
      "properties": {
        "notifId": {
          "type": "string",
          "description": "Unique notification ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetDeviceId": {
          "type": "string",
          "description": "Target deviceId or 'all'",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Notification banner heading",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Notification body message",
          "maxLength": 500
        },
        "durationSeconds": {
          "type": "number",
          "description": "Display duration in seconds before auto-hiding"
        },
        "sentBy": {
          "type": "string",
          "enum": ["telegram", "app_0069"],
          "description": "Channel used by the owner to send notification"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this notification",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAtMs": {
          "type": "number",
          "description": "Creation epoch ms"
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Expiration epoch ms"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "notifId",
        "targetDeviceId",
        "title",
        "message",
        "durationSeconds",
        "sentBy",
        "ownerId",
        "createdAtMs",
        "expiresAtMs",
        "createdAt"
      ]
    },
    "OwnerGlobalConfig": {
      "title": "OwnerGlobalConfig",
      "description": "Global master app controls including global lock toggle across all connected devices.",
      "type": "object",
      "properties": {
        "configId": {
          "type": "string",
          "description": "Fixed config document ID ('global')",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "globalLocked": {
          "type": "boolean",
          "description": "When true, all devices are locked until unlocked by owner"
        },
        "globalLockMessage": {
          "type": "string",
          "description": "Optional message shown on global lock screen",
          "maxLength": 240
        },
        "updatedBy": {
          "type": "string",
          "enum": ["telegram", "app_0069", "system"],
          "description": "Source of the latest update"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing global settings",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "configId",
        "globalLocked",
        "globalLockMessage",
        "updatedBy",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReceiptRecord": {
      "title": "ReceiptRecord",
      "description": "Persisted official CBEBirr transaction receipt indexed by reference/TID for QR verification.",
      "type": "object",
      "properties": {
        "receiptId": {
          "type": "string",
          "description": "Document key matching uppercase reference, 8-char TID, or __LATEST__",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ref": {
          "type": "string",
          "description": "CBE FT reference or 8-char TID",
          "maxLength": 64
        },
        "orderId": {
          "type": "string",
          "description": "Optional order or short transaction ID",
          "maxLength": 64
        },
        "amt": {
          "type": "string",
          "description": "Formatted transfer amount",
          "maxLength": 32
        },
        "date": {
          "type": "string",
          "description": "Formatted receipt date/time string",
          "maxLength": 64
        },
        "rec": {
          "type": "string",
          "description": "Recipient phone or account number",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Recipient display name",
          "maxLength": 120
        },
        "user": {
          "type": "string",
          "description": "Sender display name",
          "maxLength": 120
        },
        "acc": {
          "type": "string",
          "description": "Sender phone or account number",
          "maxLength": 64
        },
        "reason": {
          "type": "string",
          "description": "Payment reason or remark",
          "maxLength": 200
        },
        "bank": {
          "type": "string",
          "description": "Destination bank or wallet name",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "description": "Receipt status",
          "maxLength": 32
        },
        "serviceCharge": {
          "type": "string",
          "description": "Service fee amount string",
          "maxLength": 32
        },
        "vat": {
          "type": "string",
          "description": "VAT amount string",
          "maxLength": 32
        },
        "totalCharges": {
          "type": "string",
          "description": "Combined fee and VAT string",
          "maxLength": 32
        },
        "totalPaidAmount": {
          "type": "string",
          "description": "Total paid amount string",
          "maxLength": 32
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this receipt record",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "receiptId",
        "ref",
        "amt",
        "date",
        "rec",
        "name",
        "user",
        "acc",
        "reason",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SmsMessageRecord": {
      "title": "SmsMessageRecord",
      "description": "Device-isolated SMS/notification message persisted per physical deviceId.",
      "type": "object",
      "properties": {
        "smsId": {
          "type": "string",
          "description": "Unique SMS message document ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Originating device identifier (strictly isolated per device, never 'all')",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "description": "Conversation thread key",
          "maxLength": 80
        },
        "sender": {
          "type": "string",
          "description": "Sender address or label",
          "maxLength": 80
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name",
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "description": "SMS body text",
          "maxLength": 2000
        },
        "timestamp": {
          "type": "string",
          "description": "Formatted display timestamp",
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "description": "ISO or formatted timestamp",
          "maxLength": 64
        },
        "isOutgoing": {
          "type": "boolean",
          "description": "Whether message was outgoing"
        },
        "status": {
          "type": "string",
          "enum": ["delivered", "read", "pending"],
          "description": "Message delivery/read status"
        },
        "isBank": {
          "type": "boolean",
          "description": "Whether message is a banking notification"
        },
        "bankName": {
          "type": "string",
          "description": "Bank name",
          "maxLength": 80
        },
        "destBank": {
          "type": "string",
          "description": "Destination bank or wallet",
          "maxLength": 80
        },
        "transferLabel": {
          "type": "string",
          "description": "Transfer label inside SMS text",
          "maxLength": 80
        },
        "reason": {
          "type": "string",
          "description": "Transaction reason",
          "maxLength": 200
        },
        "creditAccountType": {
          "type": "string",
          "description": "Credit account type",
          "maxLength": 80
        },
        "amount": {
          "type": "string",
          "description": "Formatted transaction amount",
          "maxLength": 32
        },
        "balance": {
          "type": "string",
          "description": "Formatted post-transaction balance",
          "maxLength": 32
        },
        "recipient": {
          "type": "string",
          "description": "Recipient name",
          "maxLength": 120
        },
        "recipientAccount": {
          "type": "string",
          "description": "Recipient phone or account",
          "maxLength": 64
        },
        "fullName": {
          "type": "string",
          "description": "Sender full name",
          "maxLength": 120
        },
        "reference": {
          "type": "string",
          "description": "Transaction reference",
          "maxLength": 64
        },
        "txnId": {
          "type": "string",
          "description": "8-char transaction ID",
          "maxLength": 64
        },
        "receiptUrl": {
          "type": "string",
          "description": "Receipt URL",
          "maxLength": 1000
        },
        "synced": {
          "type": "boolean",
          "description": "Whether synced to device"
        },
        "isDeposit": {
          "type": "boolean",
          "description": "Whether deposit transaction"
        },
        "createdAtMs": {
          "type": "number",
          "description": "Creation epoch ms"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this SMS record",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "smsId",
        "deviceId",
        "conversationId",
        "sender",
        "senderName",
        "text",
        "timestamp",
        "date",
        "isOutgoing",
        "status",
        "isBank",
        "createdAtMs",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportSession": {
      "title": "SupportSession",
      "description": "Consent-based transparent live support session linking owner dashboard with an explicitly consenting device.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique support session document ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Target device identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "description": "Target device label",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "ended", "declined"],
          "description": "Explicit user consent session lifecycle state"
        },
        "requestedBy": {
          "type": "string",
          "enum": ["app_0069", "ram_control"],
          "description": "Initiating support surface"
        },
        "currentStep": {
          "type": "number",
          "description": "Active app screen step index"
        },
        "activeTab": {
          "type": "string",
          "description": "Active tab identifier",
          "maxLength": 40
        },
        "screenTitle": {
          "type": "string",
          "description": "Readable screen label",
          "maxLength": 80
        },
        "recipientSummary": {
          "type": "string",
          "description": "Non-sensitive summary of current screen target",
          "maxLength": 140
        },
        "amountSummary": {
          "type": "string",
          "description": "Visible transfer amount string",
          "maxLength": 40
        },
        "balance": {
          "type": "number",
          "description": "Visible balance in ETB"
        },
        "userName": {
          "type": "string",
          "description": "Profile name displayed in app",
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "description": "Profile phone string",
          "maxLength": 32
        },
        "pointerX": {
          "type": "number",
          "description": "Visible support guide pointer X percent (-1 if hidden)"
        },
        "pointerY": {
          "type": "number",
          "description": "Visible support guide pointer Y percent (-1 if hidden)"
        },
        "pointerLabel": {
          "type": "string",
          "description": "Visible pointer badge label",
          "maxLength": 40
        },
        "commandSeq": {
          "type": "number",
          "description": "Monotonic operator guidance sequence number"
        },
        "commandType": {
          "type": "string",
          "enum": [
            "none",
            "navigate_step",
            "highlight_point",
            "show_tip",
            "remote_tap",
            "remote_scroll",
            "remote_input",
            "remote_key",
            "request_ussd"
          ],
          "description": "Latest operator guidance or remote touch command type"
        },
        "commandPayload": {
          "type": "string",
          "description": "Latest operator guidance or remote action payload",
          "maxLength": 240
        },
        "ussdStatus": {
          "type": "string",
          "description": "Consent & execution status JSON for remote USSD requests during screen cast",
          "maxLength": 200
        },
        "stateSeq": {
          "type": "number",
          "description": "Monotonic device UI state delta sequence number"
        },
        "frameDataUrl": {
          "type": "string",
          "description": "Compact JPEG data URL snapshot of current live screen cast",
          "maxLength": 200000
        },
        "frameSeq": {
          "type": "number",
          "description": "Monotonic screen cast frame sequence number"
        },
        "frameUpdatedAtMs": {
          "type": "number",
          "description": "Epoch ms when the latest frame was captured"
        },
        "rtcSeq": {
          "type": "number",
          "description": "Monotonic WebRTC signaling generation sequence number"
        },
        "rtcOffer": {
          "type": "string",
          "description": "Serialized WebRTC SDP offer JSON for live voice and DataChannel screen cast",
          "maxLength": 24000
        },
        "rtcAnswer": {
          "type": "string",
          "description": "Serialized WebRTC SDP answer JSON for live voice and DataChannel screen cast",
          "maxLength": 24000
        },
        "ownerMicMuted": {
          "type": "boolean",
          "description": "Whether operator microphone is muted"
        },
        "clientMicMuted": {
          "type": "boolean",
          "description": "Whether connected device microphone is muted"
        },
        "requestedAtMs": {
          "type": "number",
          "description": "Request timestamp ms"
        },
        "acceptedAtMs": {
          "type": "number",
          "description": "Acceptance timestamp ms"
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Expiration timestamp ms"
        },
        "updatedAtMs": {
          "type": "number",
          "description": "Last update timestamp ms"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this session",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "sessionId",
        "deviceId",
        "deviceName",
        "status",
        "requestedBy",
        "currentStep",
        "activeTab",
        "screenTitle",
        "recipientSummary",
        "amountSummary",
        "balance",
        "userName",
        "phoneNumber",
        "pointerX",
        "pointerY",
        "pointerLabel",
        "commandSeq",
        "commandType",
        "commandPayload",
        "ussdStatus",
        "stateSeq",
        "frameDataUrl",
        "frameSeq",
        "frameUpdatedAtMs",
        "rtcSeq",
        "rtcOffer",
        "rtcAnswer",
        "ownerMicMuted",
        "clientMicMuted",
        "requestedAtMs",
        "acceptedAtMs",
        "expiresAtMs",
        "updatedAtMs",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Real-time Wi-Fi VoIP calling session with ring/answer state and WebRTC voice signaling between owner control and a target device.",
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "description": "Fixed call session document ID per device (call_<deviceId>)",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Target device identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "description": "Target device label",
          "maxLength": 120
        },
        "callerRole": {
          "type": "string",
          "enum": ["app_0069", "ram_control"],
          "description": "Owner surface placing the Wi-Fi call"
        },
        "callerName": {
          "type": "string",
          "description": "Display caller name shown on incoming call screen and notification",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["ringing", "active", "ended", "declined", "missed"],
          "description": "Wi-Fi call lifecycle state"
        },
        "rtcSeq": {
          "type": "number",
          "description": "Monotonic WebRTC signaling generation sequence number"
        },
        "rtcOffer": {
          "type": "string",
          "description": "Serialized WebRTC SDP offer JSON",
          "maxLength": 24000
        },
        "rtcAnswer": {
          "type": "string",
          "description": "Serialized WebRTC SDP answer JSON",
          "maxLength": 24000
        },
        "ownerMicMuted": {
          "type": "boolean",
          "description": "Whether owner microphone is muted"
        },
        "clientMicMuted": {
          "type": "boolean",
          "description": "Whether target device microphone is muted"
        },
        "startedAtMs": {
          "type": "number",
          "description": "Call initiation timestamp ms"
        },
        "answeredAtMs": {
          "type": "number",
          "description": "Call answer timestamp ms"
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Ring or call TTL timestamp ms"
        },
        "updatedAtMs": {
          "type": "number",
          "description": "Last update timestamp ms"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID governing this call session",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "callId",
        "deviceId",
        "deviceName",
        "callerRole",
        "callerName",
        "status",
        "rtcSeq",
        "rtcOffer",
        "rtcAnswer",
        "ownerMicMuted",
        "clientMicMuted",
        "startedAtMs",
        "answeredAtMs",
        "expiresAtMs",
        "updatedAtMs",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified owner/admin accounts authorized for RBAC access."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceClient" },
      "description": "All registered CBEBirr Plus device sessions, online timestamps, profile state, and per-device lock flags."
    },
    "/device_transactions/{txId}": {
      "schema": { "$ref": "#/entities/DeviceTransaction" },
      "description": "All transactions logged across connected devices."
    },
    "/owner_notifications/{notifId}": {
      "schema": { "$ref": "#/entities/OwnerNotification" },
      "description": "Timed notification messages sent by the owner to one or all devices."
    },
    "/owner_config/{configId}": {
      "schema": { "$ref": "#/entities/OwnerGlobalConfig" },
      "description": "Master global configuration including global app lock state."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/ReceiptRecord" },
      "description": "Persisted official CBEBirr transaction receipts indexed by reference/TID for live QR verification."
    },
    "/sms_messages/{smsId}": {
      "schema": { "$ref": "#/entities/SmsMessageRecord" },
      "description": "Per-device isolated SMS webhook notifications stored by physical deviceId."
    },
    "/support_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/SupportSession" },
      "description": "Transparent consent-based live support sessions between admin and device."
    },
    "/call_sessions/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Real-time Wi-Fi VoIP calling sessions between owner dashboard and connected devices."
    }
  }
}
